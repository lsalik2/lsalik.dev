---
interface Props {
  path: string;
}

const { path } = Astro.props;

const segments = path === '/' ? [] : path.split('/').filter(Boolean);
---
<div class="breadcrumb">
  <span class="prompt-logo" aria-hidden="true" transition:persist="header-mark"></span>
  <a href="/" class="prompt-user">lsalik@dev</a><span class="prompt-sep">:</span><span class="prompt-root">~</span>{segments.map((seg, i) => {
    const href = '/' + segments.slice(0, i + 1).join('/');
    const isCurrent = i === segments.length - 1;
    return <>{isCurrent
      ? <><span class="prompt-sep">/</span><span class="prompt-path-current">{seg}</span></>
      : <><span class="prompt-sep">/</span><a href={href} class="prompt-path">{seg}</a></>}</>;
  })}<span class="prompt-dollar">$</span><span class="cursor" aria-hidden="true"></span>
</div>

<style>
  .breadcrumb {
    font-size: 1rem;
  }

  /* A braille "working…" spinner, like a long-running CLI command. Pure CSS:
     the frames are stepped through `content`, so no script is needed. Fixed
     at 1ch so the prompt never shifts between frames. */
  .prompt-logo {
    display: inline-block;
    width: 0.7em;
    color: var(--accent);
    /* Braille glyphs come from a fallback font and render small next to the
       prompt; scale them up so the spinner reads at a glance. */
    font-size: 1.5em;
    line-height: 1;
    vertical-align: -0.2em;
    user-select: none;
  }

  .prompt-logo::before {
    content: '⠋';
    animation: prompt-spin 0.9s steps(1, end) infinite;
  }

  @keyframes prompt-spin {
    0%    { content: '⠋'; }
    10%   { content: '⠙'; }
    20%   { content: '⠹'; }
    30%   { content: '⠸'; }
    40%   { content: '⠼'; }
    50%   { content: '⠴'; }
    60%   { content: '⠦'; }
    70%   { content: '⠧'; }
    80%   { content: '⠇'; }
    90%   { content: '⠏'; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-logo::before {
      content: '⠿';
      animation: none;
    }
  }

  .prompt-user {
    color: var(--green);
    text-decoration: none;
  }

  .prompt-user:hover {
    color: var(--accent-bright);
  }

  .prompt-sep {
    color: var(--fg-muted);
  }

  .prompt-root {
    color: var(--fg);
  }

  .prompt-path {
    color: var(--fg);
    text-decoration: none;
  }

  a.prompt-path:hover {
    color: var(--accent-bright);
  }

  .prompt-path-current {
    color: var(--fg);
  }

  .prompt-dollar {
    color: var(--green);
    margin-left: 0.25ch;
  }

  .cursor {
    display: inline-block;
    width: 0.8ch;
    height: 1.1em;
    background-color: var(--cursor);
    margin-left: 0.25ch;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
