---
import Page from '../layouts/Page.astro';
import PageHeader from '../components/PageHeader.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import { CONTACT_LINKS } from '../data/contact';
---
<Page title="Contact" path="/contact">
  <PageHeader heading="contact" description="how to reach me." />

  <TerminalFrame>
    <dl class="contact-grid">
      {CONTACT_LINKS.map(link => (
        <>
          <dt>{link.label.toLowerCase()}</dt>
          <dd><a href={link.url} target="_blank" rel="noopener noreferrer">{link.url.replace('https://', '')}</a></dd>
        </>
      ))}
    </dl>
  </TerminalFrame>
</Page>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 2rem;
    font-size: 0.9rem;
  }

  .contact-grid dt {
    color: var(--fg-muted);
  }

  .contact-grid dd {
    color: var(--fg);
  }

  .contact-grid a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .contact-grid a:hover {
    color: var(--accent-bright);
    text-decoration-color: var(--accent-bright);
  }

  /* On phones each link goes under its label, and a long one breaks rather than running out of the frame. */
  @media (max-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .contact-grid dd + dt {
      margin-top: 0.6rem;
    }

    .contact-grid a {
      overflow-wrap: anywhere;
    }
  }
</style>
